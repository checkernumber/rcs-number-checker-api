{
  "name": "RCS Number Checker API",
  "slug": "rcs-number-checker-api",
  "description": "Bulk asynchronous file-based API used to verify whether phone numbers have RCS enabled.",
  "canonical_docs": "https://docs.checknumber.ai/rcs-checker",
  "dashboard": "https://platform.checknumber.ai",
  "base_url": "https://api.checknumber.ai",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "file_format": "text; one E.164 phone number per line, or one email per line for email task types"
  },
  "result_fields": [
    {
      "field": "Number",
      "description": "Phone number in E.164 format",
      "example": "+12025551234"
    },
    {
      "field": "rcs",
      "description": "Whether number has RCS enabled",
      "example": "yes, no"
    }
  ],
  "products": [
    {
      "task_type": "rcs",
      "name": "RCS Number Checker",
      "doc_slug": "rcs-checker",
      "input_kind": "phone"
    }
  ],
  "pricing_url": "https://checknumber.ai/pricing",
  "last_updated": "2026-07-13"
}
